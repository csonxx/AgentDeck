# Template only. Supply real values using a 0600 secret file/service manager.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Leave empty for AgentDeck's current identity-only login.
# Extra scopes require approval in the Feishu application before requesting them.
FEISHU_OAUTH_SCOPE=
# Optional comma-separated tenant_key allowlist; empty permits authorized tenants.
FEISHU_ALLOWED_TENANTS=
